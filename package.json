{
  "name": "endtoend-encrypt",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env scripts/db-migrate.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:backup": "node --env-file=.env scripts/db-backup.mjs",
    "db:restore": "node --env-file=.env scripts/db-restore.mjs",
    "db:verify-backup": "node --env-file=.env scripts/check-backup.mjs",
    "b2:cors": "node --env-file=.env scripts/set-b2-cors.mjs",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@sveltejs/adapter-vercel": "^5.4.0",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.28.0",
    "jsdom": "^31.0.1",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/credential-providers": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@neondatabase/serverless": "^0.10.4",
    "@node-rs/argon2": "^2.0.2",
    "argon2-browser": "^1.18.0",
    "drizzle-orm": "^0.38.0",
    "fflate": "^0.8.2",
    "jose": "^5.9.6",
    "libsodium-wrappers-sumo": "0.7.13",
    "lucide-svelte": "^0.468.0",
    "nanoid": "^5.0.9",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "type": "module"
}
