# Neon Postgres connection string
DATABASE_URL=postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/overdrive?sslmode=require

# Signs session cookies AND derives the key that encrypts TOTP secrets at rest.
# 32+ random characters. Changing it signs everyone out and invalidates every
# stored 2FA secret (users would have to set 2FA up again).
SESSION_SECRET=change-me-to-a-long-random-value

# Backblaze B2 (S3-compatible). The bucket must be Private.
# The key needs read/write on the bucket; add "writeBuckets" only temporarily,
# to run `npm run b2:cors` once.
B2_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxx
B2_APPLICATION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET_NAME=your-bucket-name

# ---------------------------------------------------------------------------
# Who can sign up, and who runs the place
# ---------------------------------------------------------------------------
# Comma-separated emails allowed to open /settings/admin (invites, user storage).
ADMIN_EMAILS=you@example.com

# invite (default) = new accounts need an invite code you create in the admin page
# open             = anyone with the URL can sign up
# closed           = nobody can sign up
# (On a brand-new deployment with no accounts, the first sign-up is always allowed.)
REGISTRATION_MODE=invite

# Storage per account, in GB, unless an admin or an invite overrides it. 0 = unlimited.
# Backblaze B2's free tier is 10 GB in total across ALL accounts.
DEFAULT_QUOTA_GB=5

# ---------------------------------------------------------------------------
# Daily cleanup job (Vercel Cron — see vercel.json)
# ---------------------------------------------------------------------------
# Random 16+ characters. Vercel sends it as "Authorization: Bearer <value>" when
# it triggers the job; without it the endpoint refuses to run.
CRON_SECRET=change-me-to-another-long-random-value

# Database snapshots are encrypted before they reach B2. Generate an independent
# 32-byte key with `npm run db:backup` (saved in local .env), then copy that value
# and CRON_SECRET into Vercel's production environment. Keep the key offline too.
# Do not reuse SESSION_SECRET or put the key in source control.
BACKUP_ENCRYPTION_KEY=
# Optional: a separate private B2 bucket accessible to the same application key.
# B2_BACKUP_BUCKET_NAME=your-backup-bucket
# BACKUP_RETENTION_DAYS=30
# Set ONLY for recovery, pointing at a fresh, empty database (never production):
# DATABASE_RESTORE_URL=postgres://...
# Optional tuning (defaults shown):
# TRASH_RETENTION_DAYS=30
# ABANDONED_UPLOAD_HOURS=48
# ORPHAN_MIN_AGE_HOURS=24
